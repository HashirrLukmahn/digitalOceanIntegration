# Copy to .env. Nothing here is ever written to the database, the logs, or the export.

# --- Data source ---------------------------------------------------------------
# "fixtures" runs the whole pipeline against recorded payloads and needs no
# credential at all. "live" talks to DigitalOcean.
DATA_SOURCE=fixtures

# --- DigitalOcean account ------------------------------------------------------
# A read-only personal access token. In the control panel this is API -> Tokens ->
# Generate New Token, with "Read Only" selected (equivalent to the api:read scope).
# Required when DATA_SOURCE=live. Read at the moment of use and never persisted.
DIGITALOCEAN_TOKEN=

# --- Object storage (optional, off by default) ---------------------------------
# DigitalOcean's v2 API cannot list Spaces buckets or read their permissions, so
# buckets must be named explicitly. Region-qualified, comma separated.
# Public-read detection needs no credential -- naming the buckets is enough.
SPACES_BUCKETS=

# Optional. If supplied, the key's grants are checked before use and a key with
# account-wide or write access is refused. Create a Limited Access key with Read
# permission on the specific buckets you want assessed.
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# --- Local -----------------------------------------------------------------------
DATABASE_PATH=./data/app.db
LOG_LEVEL=info

# --- Reasoning agent (optional) --------------------------------------------------
# Ours, not the customer's — used to call the model that looks for escalation paths
# spanning several resources. Without it the deterministic rules still run; only the
# AI-flagged section is unavailable. https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OAuth connection (optional) -------------------------------------------------
# From cloud.digitalocean.com/account/api/applications. The callback registered there
# must match DIGITALOCEAN_REDIRECT_URI byte for byte.
DIGITALOCEAN_CLIENT_ID=
DIGITALOCEAN_CLIENT_SECRET=
DIGITALOCEAN_REDIRECT_URI=http://localhost:3000/api/connection/oauth/callback

# Encrypts the OAuth token before it is stored. An OAuth token arrives at runtime and
# cannot live in the environment, so unlike the personal access token it must be
# persisted — encrypted. Generate: openssl rand -base64 32
TOKEN_MASTER_KEY=

# Optional. DigitalOcean's read-only alias grants every read this scanner needs.
# Set to a space-separated granular list to test whether OAuth accepts those.
DO_OAUTH_SCOPE=api:read
